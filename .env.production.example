# ========================================
# Fichier .env exemple pour PRODUCTION
# ========================================
# Copier ce fichier vers .env sur le serveur
# et remplir avec les vraies valeurs

# ========================================
# Django Core Configuration
# ========================================
SECRET_KEY=GENERER_UNE_NOUVELLE_CLE_ICI_AVEC_get_random_secret_key
DEBUG=False
ALLOWED_HOSTS=amcd.alodev.ovh,www.amcd.alodev.ovh,votre_ip_vps

# ========================================
# Database Configuration
# ========================================
DB_NAME=amcd57_db
DB_USER=amcd57_user
DB_PASSWORD=votre_mot_de_passe_postgresql_securise
DB_HOST=localhost
DB_PORT=5432

# ========================================
# Email Configuration (Gmail exemple)
# ========================================
# Pour Gmail : activer l'authentification à 2 facteurs
# puis générer un "mot de passe d'application"
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre.email@gmail.com
EMAIL_HOST_PASSWORD=votre_mot_de_passe_application_gmail
DEFAULT_FROM_EMAIL=AMCD57 <votre.email@gmail.com>
SERVER_EMAIL=votre.email@gmail.com

# Alternative : SendGrid (recommandé pour production)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=votre_cle_api_sendgrid

# ========================================
# APIs
# ========================================
OPENWEATHER_API_KEY=votre_cle_api_openweathermap

# ========================================
# Security Settings (Production)
# ========================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ========================================
# Site Configuration
# ========================================
SITE_ID=1
